{
  "name": "bixxville-analog-vendor",
  "private": true,
  "type": "module",
  "description": "Builds one pinned browser file of the official Meshtastic JavaScript library. The app itself has no build step; this runs only when the library version changes.",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=esm --minify --alias:os=./shim/os.js --alias:path=./shim/path.js --alias:util=./shim/util.js --target=es2022 --legal-comments=none --outfile=../vendor/meshtastic-core-2.6.7.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@meshtastic/core": "2.6.7",
    "@meshtastic/transport-web-bluetooth": "0.1.5"
  },
  "devDependencies": {
    "esbuild": "0.25.0"
  }
}
